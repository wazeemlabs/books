  "decisions": [
    {
      "decision": "Page the KV cache in blocks of 16 tokens",
      "instead_of": "reserving each sequence's whole context up front, or paging in a larger block",
      "chapter": "ch14",
      "because": "reserving the context admits 59 sequences where paging admits 327, and at this block size paging wastes 7.7 tokens of the sequence's own memory",
      "evidence": {
        "sequences admitted, paged": 327,
        "sequences admitted, whole context reserved": 59,
        "pool used, this block size": 0.9948604601619088,
        "wasted tokens per sequence, this block size": 7.672782874617737,
        "pool used, largest block tried": 0.9597791798107256,
        "wasted tokens per sequence, largest block tried": 62.36942675159236,
        "largest block tried": 128
      },
      "would_change": "a kernel that needs longer contiguous runs than a block, or replies short enough that a block's worth of waste stops being small beside them"
    },
    {
      "decision": "Prefix caching on, with a prefix tree and least-recently-used eviction of leaves",
      "instead_of": "no prefix cache, an unstructured block cache, or evicting the least frequently used block",
      "chapter": "ch15",
      "because": "85% of prompt tokens are already in the cache at 7 GB, against an 85.4% ceiling, and the lookup costs 135 microseconds a request",
      "evidence": {
        "hit rate, tree with LRU": 0.8503861414247254,
        "hit rate, least frequently used, same size": 0.7346767479911183,
        "hit rate, unstructured, same size": 0.8503861414247254,
        "hit rate, unstructured, smallest cache": 0.5099946923554832,
        "hit rate, tree with LRU, smallest cache": 0.5517536484912986,
        "ceiling, unlimited cache": 0.853897141415125,
        "cache GB": 6.987710464,
        "lookup microseconds per request": 135.41783398977714
      },
      "would_change": "traffic with no shared prefixes, where the index costs something and returns nothing. Nothing measured here makes the feature worth turning off when prefixes are shared at all"
    },
    {
      "decision": "Continuous batching: decide the batch every iteration",
      "instead_of": "a static batch formed on a timeout",
      "chapter": "ch17",
      "because": "1.9x the throughput, and a median first token 8,659x sooner, at the same 12 requests a second on the same memory",
      "evidence": {
        "tokens/s, static": 1787.5654794356412,
        "tokens/s, continuous": 3433.470714648767,
        "TTFT p50 ms, static": 193363.06099611876,
        "TTFT p50 ms, continuous": 22.331573404841265,
        "slots holding live work, static": 0.2895724002026612,
        "slots holding live work, continuous": 1.0
      },
      "would_change": "nothing in this book. Static batching lost on every measure at every rate tried"
    },
    {
      "decision": "Chunked prefill, with a 512-token per-iteration budget",
      "instead_of": "giving a prefill an iteration of its own, or choosing a larger budget",
      "chapter": "ch18",
      "because": "of the budgets that keep both promises at 24 requests a second, this one has the highest throughput (6,764 tokens a second) and the lowest wait between tokens (9.4 ms at the 99th percentile)",
      "evidence": {
        "budgets that keep both promises": [
          512,
          1024,
          2048
        ],
        "tokens/s, prefill on its own iteration": 6664.794129908763,
        "tokens/s, this budget": 6764.39565266715,
        "between-token p99 ms, prefill on its own iteration": 185.89756659382553,
        "between-token p99 ms, this budget": 9.437888267462686,
        "between-token p99 ms, largest budget tried": 50.15109221572525,
        "TTFT p99 ms, this budget": 259.0950397226544,
        "TTFT p99 ms, next budget down": 20057.55052227477,
        "between-token promise, ms": 50,
        "first-token promise, ms": 1000
      },
      "would_change": "a looser between-token promise, which would buy a larger budget and a better first token; or a tighter one, which the smaller budgets serve at a first token this service could not sell"
    },
    {
      "decision": "First come, first served, with no priority tiers",
      "instead_of": "shortest job first, or longest job first",
      "chapter": "ch18",
      "because": "with the memory this service has, the queue order is worth 0.7% of the median end-to-end time, and the simplest order is the one that needs no estimate of how long a reply will be",
      "evidence": {
        "end-to-end p50 s, FCFS, full pool": 1.941352787478106,
        "end-to-end p50 s, shortest first, full pool": 1.9283420331812025,
        "end-to-end p50 s, FCFS, squeezed pool": 48.804181270336,
        "end-to-end p50 s, shortest first, squeezed pool": 2.132495914577504,
        "worst slowdown, FCFS, squeezed pool": 460.64976363024175,
        "worst slowdown, shortest first, squeezed pool": 61.07347843902395,
        "squeezed pool, GB": 1.91889408,
        "full pool, GB": 63.99459328
      },
      "would_change": "running the pool near full. Squeezed, shortest first is 22.9x better on the median and 7.5x better on the worst slowdown, and this decision flips"
    },
    {
      "decision": "Preempt by recomputing, not by swapping the cache out to host memory",
      "instead_of": "copying an evicted cache out over PCIe and back",
      "chapter": "ch18",
      "because": "1.00x the throughput, although recomputing loses every individual comparison: one 1,500-token sequence costs 23.8 ms to recompute against 6.1 ms to copy",
      "evidence": {
        "tokens/s, recompute": 3435.442676265699,
        "tokens/s, swap over PCIe 5.0": 3435.450826608794,
        "tokens/s, swap over NVLink": 3435.4338829015655,
        "sequences in flight, recompute": 22.109701340759397,
        "sequences in flight, swap": 21.95143267369998,
        "TTFT p99 ms, recompute": 10419.598894073426,
        "TTFT p99 ms, swap over PCIe 5.0": 32027.034835823466,
        "one sequence, recompute ms": 23.848748993939395,
        "one sequence, PCIe 5.0 ms": 6.144,
        "link fast enough to break even, GB/s": 16.48790886683099
      },
      "would_change": "a swap-in that restores a cache gradually rather than all at once. What lost here was the shape of the re-entry, not the cost of the copy: even over NVLink, which is fast enough on the arithmetic, swapping still lost"
    },
    {
      "decision": "One fleet where every machine does both phases",
      "instead_of": "splitting the same fleet into 5 prefill machines and 7 decode machines",
      "chapter": "ch19",
      "because": "1.01x the throughput on identical hardware, a first token 1.1x faster at the 99th percentile, and a second token that does not wait for a cache to cross a network",
      "evidence": {
        "tokens/s, colocated": 59853.20330561738,
        "tokens/s, best split": 59490.878074806074,
        "tokens/s the traffic asks for": 58592.8,
        "keeps up, colocated": true,
        "keeps up, best split": true,
        "TTFT p99 ms, colocated": 73.03713146907675,
        "TTFT p99 ms, best split": 82.92115874371518,
        "second token p50 ms, colocated": 6.707423751641791,
        "second token p50 ms, best split": 11.522539520000807,
        "link": "InfiniBand NDR"
      },
      "would_change": "hardware that differs by phase, or a promise tight enough that one fleet has to over-provision to keep it. Neither is true here, and this is the decision in this record most likely to be wrong for a service that is not this one"
